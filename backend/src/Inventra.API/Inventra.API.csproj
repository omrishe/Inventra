  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventra.Application\Inventra.Application.csproj" />
    <ProjectReference Include="..\Inventra.Infrastructure\Inventra.Infrastructure.csproj" />
  </ItemGroup>

</Project>
